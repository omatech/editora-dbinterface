{
  "name": "omatech/editora-dbinterface",
  "description": "Extract or Load information from Editora in powerful and misterious ways using closures with Eloquant like syntax",
  "minimum-stability": "dev",
  "require": {
    "doctrine/dbal": "^3.10 || ^4.5",
    "psr/log": "^1.1 || ^2.0 || ^3.0",
    "phpoffice/phpspreadsheet": "1.* || ^5.10",
    "jawira/plantuml-encoding": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "13.4.6",
    "fakerphp/faker": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "Omatech\\": "src/Omatech"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.12"
    },
    "allow-plugins": false,
    "sort-packages": true,
    "github-protocols": [
      "https"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "check": [
      "@test",
      "@composer validate --no-check-publish",
      "@composer audit --locked"
    ]
  },
  "prefer-stable": true
}
